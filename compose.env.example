# Copy to .env; use absolute existing paths. No credentials belong here.
FILE_SHARE_ORIGIN=https://files.example.com
FILE_SHARE_SITE=https://files.example.com
# Set to the chosen non-root host identity (check id -u and id -g).
FILE_SHARE_UID=1000
FILE_SHARE_GID=1000
FILE_SHARE_DATA=/absolute/path/to/shared-files
FILE_SHARE_AUTH=/absolute/path/to/config/auth.json
FILE_SHARE_STATE=/absolute/path/to/state
CADDY_DATA=/absolute/path/to/caddy-data
CADDY_CONFIG=/absolute/path/to/caddy-config
# Safe default: local ingress only. Do not expose publicly without SECURITY.md controls.
FILE_SHARE_BIND=127.0.0.1
FILE_SHARE_HTTP_PORT=80
FILE_SHARE_HTTPS_PORT=443
FILE_SHARE_IMAGE=go-fileshare:local
